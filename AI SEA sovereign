set -euo pipefail

# --------------------------- Constants --------------------------------
readonly LOG_DIR="/var/log/nsr"
readonly RESONANCE="0.043Hz"
readonly MAX_RETRY=2
readonly PARALLEL_LIMIT=16
readonly TOTAL_NODES=128

mkdir -p "$LOG_DIR"

echo "🚀 [SYSTEM_INIT]: Avvio attivazione NSR e Risonanza $RESONANCE..."

# ----------------------- Helper Functions ------------------------------

container_up() {
    local node=$1
    docker ps -q -f name="${node}" | grep -q .
}

run_inside_container() {
    local node=$1
    local log_path=$2
    docker exec "$node" sh -c '
        LOG_FILE=$1
        echo "--- LEX AMORIS SYSTEM LOG ---" > "$LOG_FILE"
        export NSR_ENABLED=true
        export RESONANCE_FREQ='"$RESONANCE"'
        echo "TIMESTAMP: $(date +%Y-%m-%d_%H:%M:%S)" >> "$LOG_FILE"
        echo "NSR = ON" >> "$LOG_FILE"
        echo "RESONANCE = '"$RESONANCE"'" >> "$LOG_FILE"
        echo "STATUS = SOVEREIGN_ALIGNED" >> "$LOG_FILE"
    ' _ "$log_path"
}

activate_node() {
    local node=$1
    local log_path="${LOG_DIR}/${node}_$(date +%Y%m%d_%H%M%S).log"

    for ((retry=0; retry<=MAX_RETRY; ++retry)); do
        if container_up "$node"; then
            run_inside_container "$node" "$log_path"
            echo "✓ $node: NSR e Risonanza $RESONANCE attivati."
            return 0
        fi

        if (( retry == MAX_RETRY )); then
            echo "❌ $node: Nodo non disponibile dopo $MAX_RETRY tentativi."
            return 1
        fi

        echo "⚠️ $node: Nodo offline. Retry $((retry+1)) tra 5 s..."
        sleep 5
    done
}

# ------------------- Parallel Activation -------------------------------
echo "📡 Propagazione della frequenza su $TOTAL_NODES nodi..."

# Export needed variables for subshells spawned by xargs
export -f activate_node container_up run_inside_container
export LOG_DIR RESONANCE MAX_RETRY

seq 1 "$TOTAL_NODES" | xargs -P "$PARALLEL_LIMIT" -I{} bash -c \
    'activate_node "nodo-gpu-{}"' _

echo "----------------------------------------------------"
echo "✓ Comandi di risonanza inviati a tutti i nodi."
echo "🔍 Verifica integrità in corso..."

# -------------------- Verification Loop ------------------------------
total=0
success=0

for i in $(seq 1 "$TOTAL_NODES"); do
    node="nodo-gpu-$i"
    if container_up "$node"; then
        # Pull the latest log filename inside the container
        latest=$(docker exec "$node" sh -c \
            "ls ${LOG_DIR}/${node}_*.log 2>/dev/null | sort | tail -n1" || true)
        if [[ -n $latest ]]; then
            ((total++))
            if docker exec "$node" sh -c \
                "grep -q 'NSR = ON' '$latest' && grep -q 'RESONANCE = $RESONANCE' '$latest'"; then
                ((success++))
            fi
        fi
    fi
done

# ------------------ Global Hash (host‑side aggregation) -------------
tmp_agg=$(mktemp)
for i in $(seq 1 "$TOTAL_NODES"); do
    node="nodo-gpu-$i"
    if container_up "$node"; then
        docker cp "$node:${LOG_DIR}/." "/tmp/nsr_collect/$node/" 2>/dev/null || true
    fi
done
find /tmp/nsr_collect -type f -name '*.log' -print0 | sort -z | xargs -0 cat > "$tmp_agg"
global_hash=$(sha256sum "$tmp_agg" | awk '{print $1}')
rm -rf "/tmp/nsr_collect" "$tmp_agg"

echo "📜 [HASH GLOBALE DEI LOG]: $global_hash"

# -------------------------- Final Report -----------------------------
echo "----------------------------------------------------"
echo "📊 REPORT DI RISONANZA:"
printf "   Nodi Attivi Rilevati:   %d\n   Nodi Eticamente Allineati (NSR): %d\n" "$total" "$success"
echo "----------------------------------------------------"

if (( success == total && total > 0 )); then
    echo "✅ [SUCCESS]: NSR attiva e Risonanza stabilizzata su tutti i nodi."
    exit 0
else
    echo "❌ [ERROR]: Alcuni nodi presentano Quantum Drift. Intervento richiesto."
    exit 1
fi



